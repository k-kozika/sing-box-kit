{
  "name": "sing-box-kit",
  "version": "0.1.4",
  "description": "Build and validate sing-box configurations with Bun and Node.js.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k-kozika/sing-box-kit.git"
  },
  "files": [
    "dist",
    "index.ts",
    "src",
    "schema",
    "docs",
    "scripts/generate-schema.ts",
    "tsconfig.json",
    "vite.config.ts"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    "types": "./dist/index.d.mts",
    "default": "./dist/index.mjs"
  },
  "publishConfig": {
