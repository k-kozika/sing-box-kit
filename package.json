  },
  "scripts": {
    "build": "vp pack",
    "prepack": "bun run build",
    "schema:generate": "bun scripts/generate-schema.ts"
  },
  "dependencies": {
    "@peculiar/utils": "^4.1.0",
    "@peculiar/x509": "^3.1.0",
    "ajv": "^8.20.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@actions/github": "^9.0.0",
    "@types/bun": "latest",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^7.0.2",
    "vite-plus": "1.8.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "bun@1.4.5"
}
